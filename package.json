{
  "name": "vuetation",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: click any element in a Vue.js app, annotate it, and hand an AI coding agent the exact component and source file.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/make-icons.mjs && node build.mjs",
    "dev": "node scripts/make-icons.mjs && node build.mjs --watch",
    "test": "npm run build && node test/e2e.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
